# Copy to .env (or just export these) before starting server/proxy.js.
# The key is read by the Node process only — it is never sent to the browser.

# "anthropic" or "openai" (any OpenAI-compatible /chat/completions endpoint)
COMPANION_PROVIDER=anthropic

# Your real key. Never commit this file with a value filled in.
COMPANION_API_KEY=

# Model id for the chosen provider
COMPANION_MODEL=claude-opus-5

# Optional: override the upstream endpoint (e.g. a local or self-hosted gateway)
# COMPANION_API_URL=https://api.anthropic.com/v1/messages

# Optional
COMPANION_MAX_TOKENS=320
PORT=8080
