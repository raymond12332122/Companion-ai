# Copy to .env (or just export these) before starting server/proxy.js.
# The key is read by the Node process only — it is never sent to the browser.
# Never commit this file with a real value filled in.

# Which provider the proxy talks to.
#   nvidia     NVIDIA NIM              (implemented, default)
#   openai     any OpenAI-compatible   (implemented)
#   anthropic  Anthropic Messages API  (implemented)
#   gemini     Google Gemini           (reserved — not implemented yet)
#   local      on-device model         (reserved — not implemented yet)
COMPANION_PROVIDER=nvidia

# Required. Your real key for the provider above.
# NVIDIA keys start with "nvapi-" and are created at https://build.nvidia.com
COMPANION_API_KEY=

# Required. No default is assumed: a guessed model name is one the configured
# endpoint has never heard of, and the request fails with a confusing 404.
#   nvidia     e.g. meta/llama-3.1-8b-instruct   (catalogue at build.nvidia.com)
#   openai     e.g. gpt-4o-mini
#   anthropic  e.g. claude-opus-5
COMPANION_MODEL=

# Optional: override the upstream endpoint (a gateway, or a self-hosted model
# that speaks the same wire format as the chosen provider).
# COMPANION_API_URL=

# Optional. Replies are short by design; this is the upper bound.
COMPANION_MAX_TOKENS=400

# Optional.
PORT=8080
